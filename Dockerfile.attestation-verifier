# Build stage
FROM golang:1.22-alpine AS builder

WORKDIR /app

# Copy go mod files first (changes less frequently)
COPY go.mod go.sum ./
RUN go mod download

# Copy only the Go source files needed for the build
COPY cmd/attestation-verifier/ ./cmd/attestation-verifier/
COPY pkg/ ./pkg/

# Build the binary
RUN CGO_ENABLED=0 GOOS=linux go build -ldflags="-s -w" -o /attestation-verifier ./cmd/attestation-verifier

# Runtime stage
FROM alpine:3.19

RUN apk --no-cache add ca-certificates

WORKDIR /app

# Copy the binary from builder
COPY --from=builder /attestation-verifier /app/attestation-verifier

# Expose the default port
EXPOSE 8901

# Run the server
ENTRYPOINT ["/app/attestation-verifier"]
